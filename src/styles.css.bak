@import "tailwindcss";

:root {
  font-family: "DM Sans", system-ui, sans-serif;
  font-synthesis: none;
  text-rendering: optimizeLegibility;

  color-scheme: light;
  --bg: #f4f8f4;
  --surface: #ffffff;
  --surface-soft: #edf4ee;
  --ink: #24372f;
  --muted: #718078;
  --line: #e1ebe3;
  --primary: #638b72;
  --primary-strong: #426b53;
  --primary-soft: #e7f1e8;
  --accent: #d5a66b;
  --danger: #bd625a;
  --success: #328365;
  --shadow: 0 18px 55px rgb(45 82 58 / 9%);
}

:root[data-theme="dark"] {
  color-scheme: dark;
  --bg: #151d19;
  --surface: #202b24;
  --surface-soft: #29382e;
  --ink: #e7efe8;
  --muted: #a0afa4;
  --line: #35463a;
  --primary: #8bb99a;
  --primary-strong: #a8d0b3;
  --primary-soft: #2b4032;
  --accent: #d5ad79;
  --danger: #e18a80;
  --success: #80c5a0;
  --shadow: 0 18px 55px rgb(0 0 0 / 25%);
}

* {
  box-sizing: border-box;
}

html {
  min-width: 320px;
  background: var(--bg);
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 10% 0%, var(--primary-soft), transparent 38%),
    var(--bg);
  color: var(--ink);
  line-height: 1.55;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

button:disabled {
  cursor: not-allowed;
  opacity: .55;
}

.site-shell {
  width: min(1440px, 100%);
  min-height: 100vh;
  margin: 0 auto;
  padding: 0 28px 24px;
}

.brand-ribbon {
  min-height: 82px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.brand,
.brand-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-name {
  font-size: 21px;
  font-weight: 800;
  letter-spacing: -.05em;
}

.brand-symbol,
.feature-icon {
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border-radius: 13px;
  color: white;
  background: linear-gradient(145deg, #7da98a, #4d795d);
  box-shadow: 0 6px 16px rgb(99 139 114 / 18%);
}

.brand-tag,
.eyebrow,
.sidebar-label {
  color: var(--muted);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .14em;
}

.brand-tag {
  padding: 6px 10px;
  border-radius: 99px;
  background: var(--primary-soft);
}

.ribbon-note {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--muted);
  font-size: 12px;
  font-weight: 600;
}

.icon-button {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border: 1px solid var(--line);
  border-radius: 13px;
  color: var(--primary-strong);
  background: var(--surface);
  transition: .2s ease;
}

.icon-button:hover {
  background: var(--primary-soft);
  transform: translateY(-1px);
}

.app-layout {
  min-height: calc(100vh - 150px);
  display: grid;
  grid-template-columns: 220px minmax(0, 1fr);
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 25px;
  background: var(--surface);
  box-shadow: var(--shadow);
}

.sidebar {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 26px 14px;
  border-right: 1px solid var(--line);
  background: var(--surface);
}

.sidebar-label {
  padding: 0 12px;
}

.sidebar nav {
  display: grid;
  gap: 7px;
}

.nav-link {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 14px;
  border: 0;
  border-radius: 12px;
  color: var(--muted);
  background: transparent;
  text-align: left;
  font-size: 13px;
  font-weight: 700;
  transition: .18s ease;
}

.nav-link i {
  width: 18px;
  text-align: center;
}

.nav-link:hover,
.nav-link.active {
  color: var(--primary-strong);
  background: var(--primary-soft);
}

.sidebar-bottom {
  margin-top: auto;
}

.main-content {
  min-width: 0;
  padding: 42px clamp(22px, 4vw, 58px);
  background: var(--bg);
}

.page {
  width: 100%;
  max-width: 920px;
  margin: 0 auto;
  animation: page-in .2s ease;
}

@keyframes page-in {
  from { opacity: 0; transform: translateY(5px); }
  to { opacity: 1; transform: translateY(0); }
}

.page h1 {
  max-width: 760px;
  margin: 10px 0 14px;
  color: var(--ink);
  font-size: clamp(30px, 4vw, 48px);
  font-weight: 800;
  letter-spacing: -.055em;
  line-height: 1.12;
}

.page h2 {
  color: var(--ink);
  font-size: 23px;
  letter-spacing: -.04em;
}

.page h3 {
  margin: 0 0 10px;
  color: var(--ink);
  font-size: 17px;
}

.page-intro {
  max-width: 720px;
  margin: 0 0 28px;
  color: var(--muted);
  font-size: 15px;
}

.feature-grid,
.facts-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  margin: 28px 0 38px;
}

.feature-card,
.surface-card {
  border: 1px solid var(--line);
  border-radius: 18px;
  background: var(--surface);
  box-shadow: 0 5px 18px rgb(44 78 54 / 3%);
}

.feature-card {
  position: relative;
  min-height: 160px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 9px;
  padding: 20px;
  color: var(--ink);
  text-align: left;
  transition: .2s ease;
}

.feature-card:hover {
  border-color: var(--primary);
  transform: translateY(-3px);
  box-shadow: var(--shadow);
}

.feature-icon {
  width: 34px;
  height: 34px;
  border-radius: 11px;
  font-size: 14px;
}

.feature-card strong {
  font-size: 16px;
}

.feature-card > span:not(.feature-icon):not(.feature-arrow) {
  color: var(--muted);
  font-size: 13px;
}

.feature-arrow {
  position: absolute;
  right: 20px;
  bottom: 20px;
  color: var(--primary);
}

.facts-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.facts-grid .surface-card {
  padding: 18px;
  color: var(--muted);
  font-size: 13px;
}

.form-card,
.gauge-card,
.quiz-card,
.offer-card,
.remaining-card {
  padding: 22px;
  margin: 16px 0;
}

label {
  display: block;
  margin: 14px 0;
  color: var(--ink);
  font-size: 13px;
  font-weight: 700;
}

label strong {
  float: right;
  color: var(--primary-strong);
}

input,
select,
textarea {
  width: 100%;
  margin-top: 8px;
  padding: 11px 13px;
  border: 1px solid var(--line);
  border-radius: 11px;
  outline: none;
  color: var(--ink);
  background: var(--surface-soft);
}

input[type="range"] {
  padding: 0;
  accent-color: var(--primary);
}

input:focus,
select:focus,
textarea:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px var(--primary-soft);
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 42px;
  padding: 10px 16px;
  border: 1px solid transparent;
  border-radius: 11px;
  color: white;
  background: var(--primary);
  font-size: 13px;
  font-weight: 750;
  transition: .18s ease;
}

.button:hover {
  background: var(--primary-strong);
  transform: translateY(-1px);
}

.button-secondary {
  color: var(--primary-strong);
  border-color: var(--line);
  background: var(--primary-soft);
}

.button-secondary:hover {
  background: var(--surface-soft);
}

.notice {
  margin: 14px 0;
  padding: 14px 16px;
  border: 1px solid var(--line);
  border-radius: 13px;
  color: var(--ink);
  background: var(--surface-soft);
  font-size: 13px;
}

.notice-warning {
  border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
}

.notice-success {
  border-color: color-mix(in srgb, var(--success) 40%, var(--line));
}

.notice-danger {
  border-color: color-mix(in srgb, var(--danger) 40%, var(--line));
}

.offer-list {
  display: grid;
  gap: 12px;
}

.offer-heading,
.stat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
}

.offer-dae,
.gauge-value,
.growth-number {
  color: var(--primary-strong);
  font-size: 25px;
  font-weight: 800;
}

.offer-dae small {
  color: var(--muted);
  font-size: 11px;
}

.offer-tag {
  display: inline-block;
  margin: 3px 5px 3px 0;
  padding: 4px 8px;
  border-radius: 99px;
  color: var(--muted);
  background: var(--surface-soft);
  font-size: 10px;
  font-weight: 700;
}

.offer-tag.best {
  color: var(--primary-strong);
  background: var(--primary-soft);
}

.offer-bar,
.gauge-track {
  height: 9px;
  overflow: hidden;
  margin: 15px 0;
  border-radius: 99px;
  background: var(--surface-soft);
}

.offer-bar span,
.gauge-track span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: var(--primary);
}

.stat-row {
  margin: 8px 0;
  color: var(--muted);
  font-size: 13px;
}

.stat-row strong {
  color: var(--ink);
}

.offer-card .button {
  margin-top: 12px;
}

.warning-text {
  color: var(--danger);
  font-size: 13px;
  font-weight: 700;
}

.gauge-labels {
  display: flex;
  justify-content: space-between;
  color: var(--muted);
  font-size: 11px;
}

.remaining-card {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  color: var(--muted);
}

.remaining-card strong {
  color: var(--primary-strong);
}

.quiz-card h2 {
  line-height: 1.4;
}

.quiz-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 18px 0;
}

.next-question {
  display: flex;
  margin-top: 14px;
}

.growth-number {
  display: block;
  margin: 8px 0;
  font-size: clamp(24px, 4vw, 34px);
}

.muted-note {
  color: var(--muted);
  font-size: 12px;
}

.assistant-placeholder {
  padding: 32px;
  text-align: center;
}

.assistant-placeholder > i {
  color: var(--primary);
  font-size: 30px;
}

.assistant-placeholder p {
  max-width: 560px;
  margin: 0 auto 18px;
  color: var(--muted);
}

.site-footer {
  padding: 18px 0 0;
  color: var(--muted);
  text-align: center;
  font-size: 11px;
}

/* Settings drawer: rendered through createPortal() into document.body. */
.settings-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  justify-content: flex-end;
  background: rgb(10 20 14 / 48%);
  backdrop-filter: blur(5px);
}

.settings-drawer {
  width: min(520px, 100%);
  height: 100%;
  overflow-y: auto;
  padding: 28px;
  border-left: 1px solid var(--line);
  background: var(--surface);
  box-shadow: -15px 0 50px rgb(0 0 0 / 20%);
  animation: drawer-in .22s ease;
}

@keyframes drawer-in {
  from { transform: translateX(24px); opacity: .7; }
  to { transform: translateX(0); opacity: 1; }
}

.settings-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 24px;
}

.settings-heading h2 {
  margin: 5px 0 0;
  color: var(--ink);
}

.settings-footer {
  position: sticky;
  bottom: -28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin: 22px -28px -28px;
  padding: 16px 28px;
  border-top: 1px solid var(--line);
  background: var(--surface);
}

.settings-footer [role="status"] {
  color: var(--success);
  font-size: 12px;
}

@media (max-width: 760px) {
  .site-shell {
    padding: 0 10px 18px;
  }

  .brand-ribbon {
    min-height: 68px;
  }

  .ribbon-note,
  .brand-tag {
    display: none;
  }

  .app-layout {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - 110px);
  }

  .main-content {
    order: 1;
    flex: 1;
    padding: 26px 16px;
  }

  .sidebar {
    position: sticky;
    bottom: 0;
    z-index: 2;
    order: 2;
    padding: 7px 4px calc(7px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
    border-right: 0;
  }

  .sidebar-label,
  .sidebar-bottom {
    display: none;
  }

  .sidebar nav {
    display: flex;
    justify-content: space-around;
    gap: 2px;
  }

  .nav-link {
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    padding: 8px 2px;
    font-size: 10px;
    text-align: center;
  }

  .nav-link i {
    font-size: 16px;
  }

  .feature-grid {
    gap: 9px;
  }

  .feature-card {
    min-height: 150px;
    padding: 14px;
  }

  .facts-grid {
    grid-template-columns: 1fr;
  }

  .form-grid {
    grid-template-columns: 1fr;
    gap: 0;
  }

  .settings-drawer {
    padding: 22px 18px;
  }

  .settings-footer {
    bottom: -22px;
    margin: 22px -18px -22px;
    padding: 14px 18px;
  }
}

@media (max-width: 420px) {
  .feature-grid {
    grid-template-columns: 1fr;
  }

  .brand-name {
    font-size: 18px;
  }

  .remaining-card {
    flex-direction: column;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    transition-duration: .01ms !important;
  }
}

/* ==========================================
   FINCONSULT — REACT UI STYLES
   ========================================== */

/* Theme variable compatibility */
:root {
  --primary-strong: var(--primary-dark);
}

:root[data-theme="dark"] {
  --bg: #151d19;
  --surface: #202b24;
  --surface-soft: #29382e;
  --ink: #e7efe8;
  --muted: #a0afa4;
  --line: #35463a;
  --primary: #8bb99a;
  --primary-dark: #a8d0b3;
  --primary-strong: #a8d0b3;
  --primary-soft: #2b4032;
  --accent: #d5ad79;
  --shadow: 0 18px 55px rgb(0 0 0 / 25%);
  color-scheme: dark;
}

body {
  background: var(--bg);
  color: var(--ink);
}

/* Main application shell */
.site-shell {
  width: min(1440px, 100%);
  min-height: 100vh;
  margin: auto;
  padding: 0 28px 24px;
  overflow: visible;
}

.brand-ribbon {
  max-width: none;
  height: 82px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-name {
  font-size: 21px;
  font-weight: 800;
}

.brand-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.ribbon-note {
  display: flex;
  align-items: center;
  gap: 8px;
}

.icon-button {
  width: 42px;
  height: 42px;
  display: grid;
  place-items: center;
  border: 1px solid var(--line);
  border-radius: 13px;
  color: var(--primary-strong);
  background: var(--surface);
  cursor: pointer;
  transition: .2s;
}

.icon-button:hover {
  background: var(--primary-soft);
  transform: translateY(-1px);
}

/* Main two-column layout */
.app-layout {
  min-height: calc(100vh - 150px);
  display: grid;
  grid-template-columns: 220px minmax(0, 1fr);
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 25px;
  background: var(--surface);
  box-shadow: var(--shadow);
}

.sidebar {
  display: flex;
  flex-direction: column;
  gap: 16px;
  padding: 26px 14px;
  border-right: 1px solid var(--line);
  background: var(--surface);
}

.sidebar-label {
  padding: 0 12px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .14em;
}

.sidebar nav {
  display: grid;
  gap: 7px;
}

.nav-link {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 14px;
  border: 0;
  border-radius: 12px;
  color: var(--muted);
  background: transparent;
  text-align: left;
  font-size: 13px;
  font-weight: 700;
  cursor: pointer;
}

.nav-link i {
  width: 18px;
  text-align: center;
}

.nav-link:hover,
.nav-link.active {
  color: var(--primary-strong);
  background: var(--primary-soft);
}

.sidebar-bottom {
  margin-top: auto;
}

/* Main page */
.main-content {
  min-width: 0;
  padding: 42px clamp(22px, 4vw, 58px);
  background: var(--bg);
}

.page {
  width: 100%;
  max-width: 920px;
  margin: auto;
}

.page h1 {
  max-width: 760px;
  margin: 10px 0 14px;
  font-size: clamp(30px, 4vw, 48px);
  font-weight: 800;
  letter-spacing: -.055em;
  line-height: 1.12;
}

.page-intro {
  max-width: 720px;
  margin-bottom: 28px;
  color: var(--muted);
  font-size: 15px;
}

.eyebrow {
  color: var(--primary);
  font-size: 10px;
  font-weight: 800;
  letter-spacing: .14em;
}

/* Dashboard cards */
.feature-grid,
.facts-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  margin: 28px 0 38px;
}

.feature-card,
.surface-card {
  border: 1px solid var(--line);
  border-radius: 18px;
  background: var(--surface);
  box-shadow: 0 5px 18px rgb(44 78 54 / 3%);
}

.feature-card {
  position: relative;
  min-height: 160px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 9px;
  padding: 20px;
  color: var(--ink);
  text-align: left;
  cursor: pointer;
  transition: .2s;
}

.feature-card:hover {
  border-color: var(--primary);
  transform: translateY(-3px);
  box-shadow: var(--shadow);
}

.feature-icon {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border-radius: 11px;
  color: white;
  background: var(--primary);
}

.feature-card strong {
  font-size: 16px;
}

.feature-card > span:not(.feature-icon):not(.feature-arrow) {
  color: var(--muted);
  font-size: 13px;
}

.feature-arrow {
  position: absolute;
  right: 20px;
  bottom: 20px;
  color: var(--primary);
}

.facts-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.facts-grid .surface-card {
  padding: 18px;
  color: var(--muted);
  font-size: 13px;
}

/* Forms and calculators */
.form-card,
.gauge-card,
.quiz-card,
.offer-card,
.remaining-card {
  padding: 22px;
  margin: 16px 0;
}

.form-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

label {
  display: block;
  margin: 14px 0;
  color: var(--ink);
  font-size: 13px;
  font-weight: 700;
}

label strong {
  float: right;
  color: var(--primary-strong);
}

input,
select,
textarea {
  width: 100%;
  margin-top: 8px;
  padding: 11px 13px;
  border: 1px solid var(--line);
  border-radius: 11px;
  color: var(--ink);
  background: var(--surface-soft);
}

input[type="range"] {
  padding: 0;
  accent-color: var(--primary);
}

.button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 42px;
  padding: 10px 16px;
  border: 1px solid transparent;
  border-radius: 11px;
  color: white;
  background: var(--primary);
  font-size: 13px;
  font-weight: 750;
  cursor: pointer;
}

.button:hover {
  background: var(--primary-strong);
}

.button-secondary {
  color: var(--primary-strong);
  border-color: var(--line);
  background: var(--primary-soft);
}

.notice {
  margin: 14px 0;
  padding: 14px 16px;
  border: 1px solid var(--line);
  border-radius: 13px;
  color: var(--ink);
  background: var(--surface-soft);
  font-size: 13px;
}

.notice-success {
  border-color: var(--success);
}

.notice-warning {
  border-color: var(--accent);
}

.notice-danger {
  border-color: var(--danger);
}

/* Offer comparisons */
.offer-list {
  display: grid;
  gap: 12px;
}

.offer-heading,
.stat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
}

.offer-dae,
.gauge-value,
.growth-number {
  color: var(--primary-strong);
  font-size: 25px;
  font-weight: 800;
}

.offer-bar,
.gauge-track {
  height: 9px;
  overflow: hidden;
  margin: 15px 0;
  border-radius: 99px;
  background: var(--surface-soft);
}

.offer-bar span,
.gauge-track span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: var(--primary);
}

.stat-row {
  margin: 8px 0;
  color: var(--muted);
  font-size: 13px;
}

.stat-row strong {
  color: var(--ink);
}

.offer-card .button {
  margin-top: 12px;
}

.offer-tag {
  display: inline-block;
  margin: 3px 5px 3px 0;
  padding: 4px 8px;
  border-radius: 99px;
  color: var(--muted);
  background: var(--surface-soft);
  font-size: 10px;
  font-weight: 700;
}

.offer-tag.best {
  color: var(--primary-strong);
  background: var(--primary-soft);
}

.gauge-labels {
  display: flex;
  justify-content: space-between;
  color: var(--muted);
  font-size: 11px;
}

.remaining-card {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  color: var(--muted);
}

.remaining-card strong {
  color: var(--primary-strong);
}

/* Quiz and assistant */
.quiz-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 18px 0;
}

.next-question {
  margin-top: 14px;
}

.muted-note {
  color: var(--muted);
  font-size: 12px;
}

.assistant-placeholder {
  padding: 32px;
  text-align: center;
}

.assistant-placeholder > i {
  color: var(--primary);
  font-size: 30px;
}

/* Settings overlay — separate from the normal page flow */
.settings-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: flex;
  justify-content: flex-end;
  background: rgb(10 20 14 / 48%);
  backdrop-filter: blur(5px);
}

.settings-drawer {
  width: min(520px, 100%);
  height: 100%;
  overflow-y: auto;
  padding: 28px;
  border-left: 1px solid var(--line);
  background: var(--surface);
  box-shadow: -15px 0 50px rgb(0 0 0 / 20%);
}

.settings-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 24px;
}

.settings-heading h2 {
  margin: 5px 0 0;
  font-size: 24px;
}

.settings-footer {
  position: sticky;
  bottom: -28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin: 22px -28px -28px;
  padding: 16px 28px;
  border-top: 1px solid var(--line);
  background: var(--surface);
}

.site-footer {
  padding: 18px 0 0;
  color: var(--muted);
  text-align: center;
  font-size: 11px;
}

/* Responsive layout */
@media (max-width: 760px) {
  .site-shell {
    padding: 0 10px 18px;
  }

  .brand-ribbon {
    height: 68px;
  }

  .ribbon-note,
  .brand-tag {
    display: none;
  }

  .app-layout {
    display: flex;
    flex-direction: column;
    min-height: calc(100vh - 110px);
  }

  .main-content {
    order: 1;
    flex: 1;
    padding: 26px 16px;
  }

  .sidebar {
    position: sticky;
    bottom: 0;
    z-index: 2;
    order: 2;
    padding: 7px 4px calc(7px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
    border-right: 0;
  }

  .sidebar-label,
  .sidebar-bottom {
    display: none;
  }

  .sidebar nav {
    display: flex;
    justify-content: space-around;
    gap: 2px;
  }

  .nav-link {
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    padding: 8px 2px;
    font-size: 10px;
    text-align: center;
  }

  .nav-link i {
    font-size: 16px;
  }

  .facts-grid {
    grid-template-columns: 1fr;
  }

  .form-grid {
    grid-template-columns: 1fr;
  }

  .settings-drawer {
    padding: 22px 18px;
  }
}

@media (max-width: 420px) {
  .feature-grid {
    grid-template-columns: 1fr;
  }

  .remaining-card {
    flex-direction: column;
  }
}